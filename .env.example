# Never commit real secrets. NEXT_PUBLIC values are included in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=
RESEND_API_KEY=
# Verify a sender domain before enabling delivery to arbitrary users.
RESEND_FROM_EMAIL=
RESEND_TEST_RECIPIENT=
SPORTSRADAR_API_KEY=
SPORTSRADAR_ACCESS_LEVEL=trial
